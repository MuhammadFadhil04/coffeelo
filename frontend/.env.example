# ==========================================
# Coffeelo Frontend — Public Environment Variables
# Copy this file to `frontend/.env` for local development.
# Note: Only non-secret public variables prefixed with `VITE_` belong here.
# ==========================================

# Backend REST API Base URL
VITE_API_URL=http://localhost:5000/api

# Midtrans Public Client Key (Optional — Snap public client key only, NEVER server key)
VITE_MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
VITE_MIDTRANS_IS_PRODUCTION=false
