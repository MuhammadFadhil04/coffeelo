# ==========================================
# Coffeelo Backend — Environment Variables
# Copy this file to `backend/.env` and fill in real values.
# NEVER commit `backend/.env` to Git.
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/coffeelo_db"

# JWT Authentication (Use >= 32 random characters in production)
JWT_SECRET=replace_with_at_least_32_random_secret_characters
JWT_EXPIRES_IN=7d

# Midtrans Payment Gateway (Sandbox / Production)
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
MIDTRANS_IS_PRODUCTION=false

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
